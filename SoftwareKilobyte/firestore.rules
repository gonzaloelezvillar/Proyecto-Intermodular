rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function bootstrapAdmin() { return signedIn() && request.auth.token.email in ['pinsugonsu@gmail.com', 'admin@kilobyte.es']; }
    function hasAccount() { return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function account() { return get(/databases/$(database)/documents/access/$(request.auth.uid)).data; }
    function active() { return hasAccount() && account().status == 'Activo'; }
    function admin() { return bootstrapAdmin() || (active() && account().admin == true); }
    function adminKind(kind) { return kind in ['users', 'roles', 'departments', 'attendance', 'schedules']; }
    function role() { return get(/databases/$(database)/documents/records/$(account().roleId)).data; }
    function canRead(kind) { return active() && role().readPermissions.hasAny([kind]); }
    function canWrite(kind) { return active() && role().writePermissions.hasAny([kind]); }
    function validRecord(data) {
      return data.keys().hasAll(['kind','data','revision','updatedAt','archived'])
        && data.kind is string && data.kind in ['clients','tickets','equipment','licenses','contracts','quotes','invoices','tasks','employees','users','roles','departments','documents','schedules']
        && data.data is map && data.revision is int && data.revision > 0
        && data.updatedAt is string && data.archived in [0,1]
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedBy' in data) || data.updatedBy is string);
    }

    match /records/{recordId} {
      allow get: if admin() || (active() && ((resource.data.kind == 'roles' && recordId == account().roleId) || (!adminKind(resource.data.kind) && canRead(resource.data.kind))));
      allow list: if admin() || (active() && !adminKind(resource.data.kind) && canRead(resource.data.kind));
      allow create: if validRecord(request.resource.data) && (admin() || (!adminKind(request.resource.data.kind) && canWrite(request.resource.data.kind)));
      allow update: if validRecord(request.resource.data) && request.resource.data.kind == resource.data.kind && request.resource.data.revision == resource.data.revision + 1 && (admin() || (!adminKind(resource.data.kind) && canWrite(resource.data.kind)));
      allow delete: if false;
    }

    match /activity/{activityId} {
      allow read: if admin() || (active() && !adminKind(resource.data.kind) && canRead(resource.data.kind));
      allow create: if request.resource.data.keys().hasAll(['record_id','kind','action','actor','at']) && (admin() || (!adminKind(request.resource.data.kind) && canWrite(request.resource.data.kind)));
      allow update, delete: if false;
    }

    match /invitations/{email} {
      allow get: if admin() || (signedIn() && request.auth.token.email == email);
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /access/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roleId == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.roleId
        && request.resource.data.departmentId == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.departmentId
        && request.resource.data.status == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status
        && request.resource.data.admin == false;
      allow create, update, delete: if admin();
    }

    match /web_inbox/{inboxId} {
      allow create: if request.resource.data.keys().hasAll([
          'origen','tipo','estado','nombre','email','empresa','telefono',
          'motivo','mensaje','pedido','total','fecha'
        ])
        && request.resource.data.keys().hasOnly([
          'origen','tipo','estado','nombre','email','empresa','telefono',
          'motivo','mensaje','pedido','total','fecha'
        ])
        && request.resource.data.origen == 'web-publica'
        && request.resource.data.tipo in ['contacto','pedido']
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.empresa is string && request.resource.data.empresa.size() <= 120
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 30
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 30
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.pedido is string && request.resource.data.pedido.size() <= 10000
        && (request.resource.data.total is int || request.resource.data.total is float)
        && request.resource.data.total >= 0 && request.resource.data.total <= 100000
        && request.resource.data.fecha == request.time;
      allow read: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','notaInterna','actualizadoEn']);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if request.resource.data.keys().hasAll(['type','title','message','at'])
        && request.resource.data.keys().hasOnly(['type','title','message','at','kind','recordId'])
        && request.resource.data.type in ['contacto','pedido','incidencia']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.at == request.time
        && request.resource.data.kind is string
        && request.resource.data.recordId is string
        && request.resource.data.recordId.size() >= 1 && request.resource.data.recordId.size() <= 150
        && ((signedIn() && active() && request.resource.data.type == 'incidencia' && request.resource.data.kind == 'tickets')
          || (!signedIn() && request.resource.data.type in ['contacto','pedido'] && request.resource.data.kind == 'webInbox'));
      allow read: if admin() || active();
      allow update, delete: if false;
    }

    match /time_entries/{entryId} {
      allow get: if admin() || (active() && request.auth.uid == resource.data.userId);
      allow list: if admin();
      allow create: if (active() || admin())
        && request.auth.uid == request.resource.data.userId
        && entryId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.status == 'En curso'
        && request.resource.data.startedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.endedAt == null;
      allow update: if (active() || admin())
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'Finalizada'
        && request.resource.data.endedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
